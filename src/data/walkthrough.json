          ]
        }
      ],
      "narrative": [
        {
          "kind": "paragraph",
          "text": "Bhujerba is a floating city dedicated to mining magicite. The shops here offer better equipment than Rabanastre. Make sure to upgrade your weapons and stock up on the new tier of magic spells."
        },
        {
          "kind": "paragraph",
          "text": "Don't forget to explore the city thoroughly. There are several sidequests available here, and some valuable items hidden in various locations."
        }
      ]
    },
    "wt04b": {
      "code": "wt04b",
      "kind": "loot",
      "titles": {
        "primary": {
          "jp": "ビュエルバの隠しアイテム",
          "en": "Loot Alert: Bhujerba Secrets",
          "raw": "Loot Alert: Bhujerba Secrets"
        }
      },
      "narrative": [
        {
          "kind": "paragraph",
          "text": "Check the Cloudborne Row for a hidden chest containing an Ether. Also speak to all NPCs - one will give you a valuable accessory if you answer their questions correctly."
        }
      ]
    },
    "wt05a": {
      "code": "wt05a",
      "kind": "story",
      "titles": {
        "primary": {
          "jp": "ルース魔石鉱",
          "en": "Lhusu Mines",
          "raw": "Lhusu Mines"
        }
      },
      "crystals": {
        "save": true
      },
      "narrative": [
        {
          "kind": "paragraph",
          "text": "The Lhusu Mines are a complex dungeon with multiple levels. Be prepared for tough battles against Skeletons and Wisps. Save frequently at the crystal points throughout the mines."
        }
      ]
    }
